{
  "name": "cachestorm-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify:export": "node scripts/verify-export.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/generate-assets.mjs",
    "commands": "node scripts/generate-commands.mjs",
    "commands:check": "node scripts/generate-commands.mjs --check",
    "preview": "node scripts/serve.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "test:background": "node --test scripts/site-*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.577.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
